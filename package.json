{
  "name": "yello",
  "version": "0.2.2",
  "private": true,
  "description": "A playful local-first Pomodoro desktop app built with Electron and React.",
  "main": "./out/main/index.js",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "author": "rinqtf",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/run-electron-vite.mjs dev",
    "build": "pnpm typecheck && electron-vite build",
    "preview": "node scripts/run-electron-vite.mjs preview",
    "prepare:icons": "bash scripts/prepare-icons.sh",
    "pack": "pnpm run prepare:icons && electron-vite build && electron-builder --publish never",
    "release": "pnpm run prepare:icons && electron-vite build && electron-builder --publish always",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^37.2.4",
    "electron-builder": "^25.1.8",
    "electron-vite": "^4.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.rinqtf.yello",
    "productName": "Yello",
    "asar": true,
    "files": [
      "out/**",
      "assets/**"
    ],
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icon.png"
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-builder",
      "esbuild"
    ]
  }
}
